# Copy to .env. All credentials below are for your own local/test services.
PORT=8080
NODE_ENV=development
POSTGRES_USER=wedding
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=wedding
DATABASE_URL=postgresql://wedding:local-development-only@localhost:5432/wedding?schema=public
# Generate two independent values: openssl rand -base64 32
JWT_SECRET_KEY=
JWT_REFRESH_KEY=
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
# Stripe, OpenAI, and SendGrid credentials are required at startup.
# Supply your own development credentials before starting the API.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
SENDGRID_API_KEY=
# Separate AI microservice (not included in this repository)
FASTAPI_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/calendar/oauth/callback
# Optional partner-platform integration
DATING_PARTNER_API_KEY=
PARTNER_API_URL=
PARTNER_API_KEY=
PARTNER_CONTACT_EMAIL=
PARTNER_CONTACT_NAME=
PARTNER_COMMISSION_RATE=0.1
PARTNER_STRIPE_ACCOUNT_ID=
