generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConfirmationStatus {
  pending
  confirmed
  rejected
}

enum UserRole {
  admin
  superAdmin
  vendor
}

enum WeddingType {
  chinese
  malay
  indian
  western
  others
}

enum WeddingService {
  venue
  catering
  photography
  decoration
  music
  attire
  makeup
  transportation
}

enum WeddingStyle {
  luxury
  modern
  traditional
  rustic
}

// tentative numbers, need to market research to finalize
enum BudgetBucket {
  low // up to $10,000
  medium // $10,000 to $30,000
  high // $30,000 to $50,000
  luxury // above $50,000
}

enum GuestCountBucket {
  small // up to 50
  medium // 50 to 150
  large // above 150
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  COMPLETED
}

enum VendorOnboardingStatus {
  pending
  rejected
  onboarded
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin      Admin?
  superAdmin SuperAdmin?
  vendor     Vendor?
}

model Admin {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id])

  isCouple          Boolean          @default(true)
  isSuspended       Boolean          @default(false)
  onboardedDate     DateTime         @default(now())
  weddingType       WeddingType
  budgetBucket      BudgetBucket
  guestCountBucket  GuestCountBucket
  preferredStyle    WeddingStyle
  preferredServices WeddingService[]
  weddings          Wedding[]        @relation("AdminWeddings")
}

model SuperAdmin {
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model Vendor {
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  vendorWebsite    String?
  uenNumber        String?
  onboardedDate    DateTime               @default(now())
  bio              String?
  rating           Float?                 @default(0)
  isSuspended      Boolean                @default(false)
  serviceOffered   WeddingService
  styleOffered     WeddingStyle
  weddingTypes     WeddingType[]
  capacity         Int?
  listings         Listing[]
  onboardingStatus VendorOnboardingStatus @default(pending)
}

model Wedding {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  location  String?
  guests    Guest[]
  admins    Admin[]  @relation("AdminWeddings")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Guest {
  id                 Int                @id @default(autoincrement())
  email              String             
  name               String
  allergies          String?
  group              String?
  confirmationStatus ConfirmationStatus @default(pending)
  weddingId          Int
  wedding            Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  primaryGuestId     Int?
  primaryGuest       Guest?             @relation("AccompanyingGuests", fields: [primaryGuestId], references: [id])
  accompanyingGuests Guest[]            @relation("AccompanyingGuests")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Listing {
  id            Int       @id @default(autoincrement())
  listingName   String
  price         Float
  availabilities DateTime[] 
  remarks       String

  // Relations
  vendorId      Int
  vendor        Vendor   @relation(fields: [vendorId], references: [userId], onDelete: Cascade)

  // Many-to-many with Orders
  orders        OrderListing[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id            Int       @id @default(autoincrement())
  orderStatus   OrderStatus @default(PENDING)
  paymentMethod String
  purchaseDate  DateTime   @default(now())
  remark        String?

  // Relations
  weddingId     Int
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  // Many-to-many with Listings
  listings      OrderListing[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model OrderListing {
  orderId   Int
  listingId Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([orderId, listingId])
}