generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum UserRole {
  ADMIN
  SUPERADMIN
  VENDOR
}

enum WeddingType {
  CHINESE
  MALAY
  INDIAN
  WESTERN
  OTHERS
}

enum WeddingService {
  VENUE
  CATERING
  PHOTOGRAPHY
  DECORATION
  MUSIC
  ATTIRE
  MAKEUP
  TRANSPORTATION
}

enum WeddingStyle {
  LUXURY
  MODERN
  TRADITIONAL
  RUSTIC
}

// tentative numbers, need to market research to finalize
enum BudgetBucket {
  LOW // up to $10,000
  MEDIUM // $10,000 to $30,000
  HIGH // $30,000 to $50,000
  LUXURY // above $50,000
}

enum GuestCountBucket {
  SMALL // up to 50
  MEDIUM // 50 to 150
  LARGE // above 150
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum VendorOnboardingStatus {
  PENDING
  REJECTED
  ONBOARDED
}

enum EmailTemplateType {
  PASSWORD_RESET
  WELCOME
  VERIFY_EMAIL
  CREATE_ACCOUNT
  SUPER_ADMIN_ONBOARDING
  VENDOR_STATUS
  VENDOR_SUSPENSION
  ADMIN_SUSPENSION
  COLLABORATOR_ADDED
  CALENDAR_ACCESS_REQUEST
  RSVP_INVITATION
  CUSTOM
  GUEST_GRATITUDE_CARD
  COLLABORATOR_GRATITUDE_CARD
  VENDOR_GRATITUDE_CARD
  VENDOR_BOOKING_REJECTION
  VENDOR_BOOKING_CONFIRMATION
}

enum CalendarAccessStatus {
  NOT_REQUESTED
  REQUESTED
  REJECTED
  CONNECTED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin      Admin?
  superAdmin SuperAdmin?
  vendor     Vendor?
}

model Admin {
  userId                   Int                       @id
  user                     User                      @relation(fields: [userId], references: [id])
  isSuspended              Boolean                   @default(false)
  onboardedDate            DateTime                  @default(now())
  weddings                 Wedding[]                 @relation("AdminWeddings")
  mainWedding              Wedding?                  @relation("MainCouple", fields: [mainWeddingId], references: [id])
  mainWeddingId            Int?
  cart                     Cart?
  googleCalendarConnection GoogleCalendarConnection?
}

model GoogleCalendarConnection {
  id                Int                  @id @default(autoincrement())
  guestId           Int?                 @unique
  guest             Guest?               @relation(fields: [guestId], references: [id], onDelete: Cascade)
  adminId           Int?                 @unique
  admin             Admin?               @relation(fields: [adminId], references: [userId], onDelete: Cascade)
  accessToken       String
  refreshToken      String
  tokenExpiry       DateTime
  email             String
  accessStatus      CalendarAccessStatus @default(NOT_REQUESTED)
  accessRequestedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model SuperAdmin {
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model Vendor {
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  vendorWebsite       String?
  uenNumber           String?
  onboardedDate       DateTime               @default(now())
  bio                 String?
  rating              Float?                 @default(0)
  isSuspended         Boolean                @default(false)
  serviceOffered      WeddingService?
  styleOffered        WeddingStyle?
  weddingTypes        WeddingType[]
  capacity            Int?
  listings            Listing[]
  onboardingStatus    VendorOnboardingStatus @default(PENDING)
  notificationDetails NotificationDetails?

  // Stripe Connect fields
  stripeConnectAccountId String?  @unique
  stripeAccountOnboardingComplete Boolean @default(false)
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)
}

model EmailTemplate {
  id                    Int                 @id @default(autoincrement())
  name                  String
  subject               String
  htmlContent           String
  textContent           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  notificationDetails   NotificationDetails @relation(fields: [notificationDetailsId], references: [id])
  notificationDetailsId Int
}

model EmailNotificationHistory {
  id                    Int                 @id @default(autoincrement())
  to                    String[]
  subject               String
  body                  String
  sentAt                DateTime            @default(now())
  type                  EmailTemplateType
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  notificationDetails   NotificationDetails @relation(fields: [notificationDetailsId], references: [id])
  notificationDetailsId Int
}

model NotificationDetails {
  id                       Int                        @id @default(autoincrement())
  emailTemplates           EmailTemplate[]
  emailNotificationHistory EmailNotificationHistory[]
  wedding                  Wedding?                   @relation(fields: [weddingId], references: [id])
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  weddingId                Int?                       @unique
  vendor                   Vendor?                    @relation(fields: [vendorId], references: [userId])
  vendorId                 Int?                       @unique
  isSuperAdminNotification Boolean?                   @default(false)
}

model Wedding {
  id                         Int                  @id @default(autoincrement())
  mainCouple                 Admin[]              @relation("MainCouple")
  name                       String
  date                       DateTime?
  location                   String?
  guests                     Guest[]
  admins                     Admin[]              @relation("AdminWeddings")
  keyAttendeeIds             Int[]                @default([])
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  allocatedBudget            Float
  currentSpending            Float                @default(0)
  weddingType                WeddingType
  budgetBucket               BudgetBucket
  guestCountBucket           GuestCountBucket
  preferredStyle             WeddingStyle
  preferredServices          WeddingService[]
  payLahQR                   String?
  orders                     Order[]
  notificationDetails        NotificationDetails?
  SeatingArrangement         SeatingArrangement?
  microsite                  Microsite?
  album                      Album?
  cashGifts                  CashGift[]
  dateOptimizerEarliestDate  String?
  dateOptimizerLatestDate    String?
  dateOptimizerPreferredDays String[]             @default([])
  dateOptimizerLastResults   Json?
  gratitudeCard              GratitudeCard?
  guestbook                  Guestbook?
  wishlistItems              WishlistItem[]
}

model Microsite {
  id             Int      @id @default(autoincrement())
  templateNumber Int
  slug           String   @unique
  coupleName     String
  heroImages     String[]
  imageGallery   String[]
  schedule       Json?
  faqs           Json?
  password       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  weddingId Int     @unique
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id             Int      @id @default(autoincrement())
  title          String
  itemUrl        String
  isReserved     Boolean  @default(false)
  reservedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  weddingId Int
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model GratitudeCard {
  id                       Int     @id @default(autoincrement())
  signOffName              String
  guestCardMessage         String?
  collaboratorCardMessage  String?
  vendorCardMessage        String?
  guestCardPhotoURL        String?
  collaboratorCardPhotoURL String?

  weddingId Int     @unique
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Album {
  id                Int      @id @default(autoincrement())
  coupleName        String
  inviteCardMessage String
  landingMessage    String
  albumURL          String?
  photos            String[]  // Legacy field, kept for backward compatibility

  // New relations for enhanced photo management
  photoEntities     Photo[]
  personClusters    PersonCluster[]

  weddingId Int     @unique
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Guestbook {
  id         Int    @id @default(autoincrement())
  guestNotes Json[]

  weddingId Int     @unique
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Photo {
  id        Int      @id @default(autoincrement())
  url       String
  albumId   Int
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  // Processing metadata
  processingStatus ProcessingStatus @default(PENDING)
  processedAt      DateTime?

  // Quality metrics
  isBlurry         Boolean?
  blurScore        Float?     // 0-1000+, higher = sharper (Laplacian variance)

  // Relations
  faces            PhotoFace[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([albumId])
  @@index([processingStatus])
  @@index([isBlurry])
}

model PhotoFace {
  id       Int    @id @default(autoincrement())
  photoId  Int
  photo    Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  // Face encoding (128-dimensional vector stored as JSON array)
  // Generated by face_recognition library using dlib's ResNet model
  encoding Json

  // Bounding box coordinates (normalized 0-1 relative to image dimensions)
  x        Float
  y        Float
  width    Float
  height   Float

  // Cluster assignment (null if unclustered or outlier)
  personClusterId Int?
  personCluster   PersonCluster? @relation(fields: [personClusterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([photoId])
  @@index([personClusterId])
}

model PersonCluster {
  id        Int         @id @default(autoincrement())
  albumId   Int
  album     Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)

  // Optional label (can be set manually by user, e.g., "Bride", "Groom", "Guest 1")
  label     String?

  // Representative face encoding (centroid of all faces in cluster)
  representativeEncoding Json

  // Sample photo URL for thumbnail display
  thumbnailUrl String?

  // Relations
  faces     PhotoFace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId])
}

model Guest {
  id                       Int                       @id @default(autoincrement())
  email                    String
  name                     String
  allergies                String?
  group                    String?
  confirmationStatus       ConfirmationStatus        @default(PENDING)
  attendance               Boolean                   @default(false)
  checkInTime              DateTime?
  weddingId                Int
  wedding                  Wedding                   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  primaryGuestId           Int?
  primaryGuest             Guest?                    @relation("AccompanyingGuests", fields: [primaryGuestId], references: [id])
  accompanyingGuests       Guest[]                   @relation("AccompanyingGuests")
  googleCalendarConnection GoogleCalendarConnection?
  cashGifts                CashGift[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model Listing {
  id             Int      @id @default(autoincrement())
  listingName    String
  price          Float
  availabilities Json
  remarks        String
  imageUrls      String[]

  // Relations
  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [userId], onDelete: Cascade)

  // Many-to-many with Orders
  orders    OrderListing[]
  cartItems CartItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Order {
  id           Int         @id @default(autoincrement())
  orderStatus  OrderStatus @default(PENDING)
  totalAmount  Float
  currency     String      @default("SGD")
  purchaseDate DateTime    @default(now())
  remark       String?

  // Relations
  weddingId Int
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  // Many-to-many with Listings
  listings OrderListing[]

  // Payment relation
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model OrderListing {
  orderId       Int
  listingId     Int
  bookedSlots   Json
  bookingStatus OrderStatus @default(PENDING)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@id([orderId, listingId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  total     Float      @default(0)
  adminId   Int        @unique
  admin     Admin      @relation(fields: [adminId], references: [userId], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  selectedSlots Json

  @@unique([cartId, listingId])
}

model Payment {
  id                      Int           @id @default(autoincrement())
  stripeCheckoutSessionId String        @unique
  stripePaymentIntentId   String?
  amount                  Float
  currency                String        @default("SGD")
  paymentStatus           PaymentStatus @default(PENDING)

  // Relations
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
  @@index([paymentStatus])
}

model VendorEarning {
  id             Int      @id @default(autoincrement())
  vendorId       Int
  orderListingId String  
  orderId        Int
  listingId      Int
  grossAmount    Float    
  platformFee    Float    
  netAmount      Float    
  currency       String   @default("SGD")
  isPaidOut      Boolean  @default(false)
  payoutId       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vendorId])
  @@index([isPaidOut])
  @@index([payoutId])
  @@unique([orderId, listingId])
}

model VendorPayout {
  id                   Int      @id @default(autoincrement())
  vendorId             Int
  stripeTransferId     String   @unique
  amount               Float   
  currency             String   @default("SGD")
  status               String   
  earningsCount        Int     
  periodStart          DateTime 
  periodEnd            DateTime 
  stripePayoutId       String? 
  failureReason        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([stripeTransferId])
}

model SeatingArrangement {
  id              Int      @id @default(autoincrement())
  weddingId       Int      @unique
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  groupPriorities Json?
  tables          Json
  tablesPerRow    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CashGift {
  id        Int      @id @default(autoincrement())
  guestId   Int
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  amount    Float
  weddingId Int
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId])
  @@index([guestId])
}

model TokenBlacklist {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}
