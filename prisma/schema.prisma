generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum UserRole {
  ADMIN
  SUPERADMIN
  VENDOR
}

enum WeddingType {
  CHINESE
  MALAY
  INDIAN
  WESTERN
  OTHERS
}

enum WeddingService {
  VENUE
  CATERING
  PHOTOGRAPHY
  DECORATION
  MUSIC
  ATTIRE
  MAKEUP
  TRANSPORTATION
}

enum WeddingStyle {
  LUXURY
  MODERN
  TRADITIONAL
  RUSTIC
}

// tentative numbers, need to market research to finalize
enum BudgetBucket {
  LOW // up to $10,000
  MEDIUM // $10,000 to $30,000
  HIGH // $30,000 to $50,000
  LUXURY // above $50,000
}

enum GuestCountBucket {
  SMALL // up to 50
  MEDIUM // 50 to 150
  LARGE // above 150
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum VendorOnboardingStatus {
  PENDING
  REJECTED
  ONBOARDED
}

enum EmailTemplateType {
  PASSWORD_RESET
  WELCOME
  VERIFY_EMAIL
  CREATE_ACCOUNT
  VENDOR_STATUS
  VENDOR_SUSPENSION
  ADMIN_SUSPENSION
  CUSTOM
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin      Admin?
  superAdmin SuperAdmin?
  vendor     Vendor?
}

model Admin {
  userId        Int       @id
  user          User      @relation(fields: [userId], references: [id])
  isSuspended   Boolean   @default(false)
  onboardedDate DateTime  @default(now())
  weddings      Wedding[] @relation("AdminWeddings")
  mainWedding   Wedding?  @relation("MainCouple", fields: [mainWeddingId], references: [id])
  mainWeddingId Int?

  cart Cart?
}

model SuperAdmin {
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model Vendor {
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  vendorWebsite       String?
  uenNumber           String?
  onboardedDate       DateTime               @default(now())
  bio                 String?
  rating              Float?                 @default(0)
  isSuspended         Boolean                @default(false)
  serviceOffered      WeddingService?
  styleOffered        WeddingStyle?
  weddingTypes        WeddingType[]
  capacity            Int?
  listings            Listing[]
  onboardingStatus    VendorOnboardingStatus @default(PENDING)
  notificationDetails NotificationDetails?
}

model EmailTemplate {
  id                    Int                 @id @default(autoincrement())
  name                  String
  subject               String
  htmlContent           String
  textContent           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  notificationDetails   NotificationDetails @relation(fields: [notificationDetailsId], references: [id])
  notificationDetailsId Int
}

model EmailNotificationHistory {
  id                    Int                 @id @default(autoincrement())
  to                    String[]
  subject               String
  body                  String
  sentAt                DateTime            @default(now())
  type                  EmailTemplateType
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  notificationDetails   NotificationDetails @relation(fields: [notificationDetailsId], references: [id])
  notificationDetailsId Int
}

model NotificationDetails {
  id                       Int                        @id @default(autoincrement())
  emailTemplates           EmailTemplate[]
  emailNotificationHistory EmailNotificationHistory[]
  wedding                  Wedding?                   @relation(fields: [weddingId], references: [id])
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  weddingId                Int?                       @unique
  vendor                   Vendor?                    @relation(fields: [vendorId], references: [userId])
  vendorId                 Int?                       @unique
  isSuperAdminNotification Boolean?                   @default(false)
}

model Wedding {
  id                  Int                  @id @default(autoincrement())
  mainCouple          Admin[]              @relation("MainCouple")
  name                String
  date                DateTime?
  location            String?
  guests              Guest[]
  admins              Admin[]              @relation("AdminWeddings")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  weddingType         WeddingType
  budgetBucket        BudgetBucket
  guestCountBucket    GuestCountBucket
  preferredStyle      WeddingStyle
  preferredServices   WeddingService[]
  orders              Order[]
  notificationDetails NotificationDetails?
  SeatingArrangement  SeatingArrangement?
  microsite         Microsite?
}

model Microsite {
  id            Int      @id @default(autoincrement())
  templateNumber Int
  slug              String           @unique
  coupleName    String
  heroImages    String[]
  imageGallery  String[]  
  schedule      Json?    
  faqs          Json?    
  password      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  weddingId     Int      @unique
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Guest {
  id                 Int                @id @default(autoincrement())
  email              String
  name               String
  allergies          String?
  group              String?
  confirmationStatus ConfirmationStatus @default(PENDING)
  attendance         Boolean            @default(false)
  weddingId          Int
  wedding            Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  primaryGuestId     Int?
  primaryGuest       Guest?             @relation("AccompanyingGuests", fields: [primaryGuestId], references: [id])
  accompanyingGuests Guest[]            @relation("AccompanyingGuests")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Listing {
  id             Int            @id @default(autoincrement())
  listingName    String
  price          Float
  availabilities Json
  remarks        String
  imageUrls      String[]
  
  // Relations
  vendorId       Int
  vendor         Vendor         @relation(fields: [vendorId], references: [userId], onDelete: Cascade)
  
  // Many-to-many with Orders
  orders         OrderListing[]
  cartItems      CartItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Order {
  id           Int            @id @default(autoincrement())
  orderStatus  OrderStatus    @default(PENDING)
  totalAmount  Float
  currency     String         @default("SGD")
  purchaseDate DateTime       @default(now())
  remark       String?
  
  // Relations
  weddingId    Int
  wedding      Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  
  // Many-to-many with Listings
  listings     OrderListing[]
  
  // Payment relation
  payments     Payment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model OrderListing {
  orderId     Int
  listingId   Int
  bookedSlots Json
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([orderId, listingId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  total     Float      @default(0)
  adminId   Int        @unique
  admin     Admin      @relation(fields: [adminId], references: [userId], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  selectedSlots Json

  @@unique([cartId, listingId])
}

model Payment {
  id                      Int           @id @default(autoincrement())
  stripeCheckoutSessionId String        @unique
  stripePaymentIntentId   String? // This is populated by webhook after payment
  amount                  Float
  currency                String        @default("SGD")
  paymentStatus           PaymentStatus @default(PENDING)
  
  
  // Relations
  orderId                 Int
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
  @@index([paymentStatus])
}

model SeatingArrangement {
  id              Int      @id @default(autoincrement())
  weddingId       Int      @unique
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  groupPriorities Json?
  tables          Json
  tablesPerRow    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TokenBlacklist {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}
