{
  "name": "wedding-management-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "npx prettier --write .",
    "generate:prisma:types": "npx prisma generate",
    "dev": "npx prisma generate && nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\" \"*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\" \"*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --verbose",
    "docker:dev:up": "docker-compose up -d",
    "docker:dev:up:windows": "docker-compose -f docker-compose.windows.yml up -d",
    "docker:dev:down": "docker-compose down -v",
    "docker:dev:down:windows": "docker-compose -f docker-compose.windows.yml down -v",
    "prisma:gui": "npx prisma studio",
    "prisma:schema:update": "npx prisma db push",
    "prisma:seed:dev": "ts-node prisma/seed.ts",
    "prisma:seed:recommendation:dev": "ts-node prisma/seed.recommendation.ts",
    "stripe:start": "stripe listen --forward-to localhost:8080/payments/webhook",
    "prisma:schema:update:prod": "npx dotenv -e .env.prod -- npx prisma migrate deploy",
    "prisma:gui:prod": "npx dotenv -e .env.prod -- npx prisma studio",
    "prisma:seed:prod": "npx dotenv -e .env.prod -- npx prisma db seed",
    "build:lambda": "npx nest build --webpack"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "^6.15.0",
    "@sendgrid/mail": "^8.1.5",
    "@types/handlebars": "^4.0.40",
    "@types/pdfkit": "^0.17.3",
    "@vendia/serverless-express": "^4.12.6",
    "archiver": "^7.0.1",
    "aws-cdk-lib": "^2.277.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "googleapis": "^190.0.0",
    "handlebars": "^4.7.10",
    "openai": "^6.1.0",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "stripe": "^18.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.17",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.15.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0",
    "@types/aws-lambda": "^8.10.160"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "qs": "^6.16.1",
    "picomatch@4": "^4.0.4",
    "ajv@8": "^8.18.0",
    "tmp": "^0.2.6",
    "glob@>=9 <15": {
      ".": "^14.0.6",
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
